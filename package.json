{
  "name": "blog",
  "version": "2.0.0",
  "description": "David's Blog",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@vuepress/plugin-pwa": "2.0.0-rc.131"
      }
    }
  },
  "scripts": {
    "docs:build": "node --max-old-space-size=8192 node_modules/vuepress/bin/vuepress.js build src && node scripts/inject-blog-redirects.mjs",
    "docs:clean-dev": "vuepress dev src --clean-cache",
    "docs:dev": "vuepress dev src"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-icon": "2.0.0-rc.130",
    "@vuepress/plugin-pwa": "2.0.0-rc.131",
    "@vuepress/plugin-register-components": "2.0.0-rc.130",
    "echarts": "^6.1.0",
    "mermaid": "^11.16.1",
    "sass-embedded": "^1.100.0",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  }
}
