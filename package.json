{
  "name": "blog",
  "version": "2.0.0",
  "description": "David's Blog",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@vuepress/plugin-pwa": "2.0.0-rc.131"
      }
    }
  },
  "scripts": {
    "data:refresh": "node scripts/fetch-github-stars.mjs",
    "docs:build": "node --max-old-space-size=5120 node_modules/vuepress/bin/vuepress.js build src",
    "docs:clean-dev": "vuepress dev src --clean-cache",
    "docs:dev": "vuepress dev src",
    "docs:verify": "node scripts/verify-site.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm run docs:build && pnpm run docs:verify && pnpm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/plugin-icon": "2.0.0-rc.130",
    "@vuepress/plugin-pwa": "2.0.0-rc.131",
    "@vuepress/plugin-register-components": "2.0.0-rc.130",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.130",
    "echarts": "^6.1.0",
    "mermaid": "^11.17.2",
    "sass-embedded": "^1.104.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vuepress": "2.0.0-rc.30",
    "vuepress-theme-hope": "2.0.0-rc.107"
  }
}
